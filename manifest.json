{
  "manifest_version": 3,
  "name": "DeskLemurOS Browser Bridge",
  "version": "0.2.0",
  "description": "Connects DeskLemurOS to browser tabs it opens: read pages, click, fill forms, and navigate. Requires DeskLemurOS.",
  "minimum_chrome_version": "120",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "permissions": [
    "nativeMessaging",
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "DeskLemurOS Browser Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
